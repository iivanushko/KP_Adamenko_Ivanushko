{% extends 'base.html.twig' %}

{% block title %}Склад и поставки{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Склад и поставки</h1>
      <div class="muted">Контроль остатков продуктов и заявок поставщикам</div>
    </div>
    <button class="btn" type="button" onclick="openModal('create-request')">Заявка поставщику</button>
  </div>

  <form class="toolbar" method="get">
    <label>Продукт
      <input name="q" value="{{ filters.q }}" placeholder="Название продукта">
    </label>
    <label style="display:flex;align-items:center;gap:8px;margin-top:22px">
      <input type="checkbox" name="low" value="1" {% if filters.low == '1' %}checked{% endif %}>
      Только низкие остатки
    </label>
    <button class="btn" type="submit">Найти</button>
    <a class="btn secondary" href="{{ path('warehouse_index') }}">Сброс</a>
  </form>

  <table>
    <thead>
      <tr>
        <th><a class="sort-link {% if filters.sort == 'product' %}active{% endif %}" href="{{ path('warehouse_index', filters|merge({sort: 'product', direction: filters.sort == 'product' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Продукт</a></th>
        <th><a class="sort-link {% if filters.sort == 'quantity' %}active{% endif %}" href="{{ path('warehouse_index', filters|merge({sort: 'quantity', direction: filters.sort == 'quantity' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Остаток</a></th>
        <th><a class="sort-link {% if filters.sort == 'min' %}active{% endif %}" href="{{ path('warehouse_index', filters|merge({sort: 'min', direction: filters.sort == 'min' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Минимум</a></th>
        <th><a class="sort-link {% if filters.sort == 'restock' %}active{% endif %}" href="{{ path('warehouse_index', filters|merge({sort: 'restock', direction: filters.sort == 'restock' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Последнее пополнение</a></th>
        <th><a class="sort-link {% if filters.sort == 'state' %}active{% endif %}" href="{{ path('warehouse_index', filters|merge({sort: 'state', direction: filters.sort == 'state' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Состояние</a></th>
        <th>Редактирование</th>
      </tr>
    </thead>
    <tbody>
    {% for item in result.items %}
      <tr>
        <td>{{ item.product_name }}</td>
        <td>{{ item.quantity|number_format(2, ',', ' ') }}</td>
        <td>{{ item.min_quantity|number_format(2, ',', ' ') }}</td>
        <td>{{ item.last_restock_date ?: 'Нет данных' }}</td>
        <td>
          {% if item.is_low %}
            <span class="pill danger">Нужно пополнить</span>
          {% else %}
            <span class="pill ok">Достаточно</span>
          {% endif %}
        </td>
        <td>
          <form class="inline-fields" method="post" action="{{ path('warehouse_stock_update', {productId: item.product_id}) }}">
            <label>Остаток
              <input name="quantity" type="number" min="0" step="0.01" value="{{ item.quantity }}">
            </label>
            <label>Минимум
              <input name="min_quantity" type="number" min="0" step="0.01" value="{{ item.min_quantity }}">
            </label>
            <button class="btn secondary" type="submit">OK</button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="6" class="muted">Продукты не найдены</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <div class="pagination">
    {% if page > 1 %}
      <a href="{{ path('warehouse_index', filters|merge({page: page - 1})) }}">Назад</a>
    {% endif %}
    <span>Страница {{ page }} из {{ result.pages }}</span>
    {% if page < result.pages %}
      <a href="{{ path('warehouse_index', filters|merge({page: page + 1})) }}">Вперед</a>
    {% endif %}
  </div>

  <section class="card" style="margin-top:18px">
    <h2>Последние заявки поставщикам</h2>
    <table>
      <thead><tr><th>Дата поставки</th><th>Поставщик</th><th>Менеджер</th><th>Состав</th><th>Статус</th></tr></thead>
      <tbody>
      {% for request in requests %}
        <tr>
          <td>{{ request.request_date }}</td>
          <td>{{ request.supplier_name }}</td>
          <td>{{ request.manager_full_name }}</td>
          <td>{{ request.products ?: 'Состав не указан' }}</td>
          <td><span class="pill {% if request.status == 'Получено' %}ok{% else %}warn{% endif %}">{{ request.status }}</span></td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="muted">Заявки еще не создавались</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <dialog id="create-request">
    <form method="post" action="{{ path('warehouse_request_create') }}">
      <div class="modal-head">
        <h2>Заявка поставщику</h2>
        <button class="btn secondary" type="button" onclick="closeModal('create-request')">Закрыть</button>
      </div>
      <div class="modal-body">
        <div class="form-grid">
          <label>Поставщик
            <select name="supplier_id" required>
              {% for supplier in suppliers %}
                <option value="{{ supplier.supplier_id }}">{{ supplier.supplier_name }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Менеджер
            <select name="manager_id" required>
              {% for manager in managers %}
                <option value="{{ manager.manager_id }}">{{ manager.manager_full_name }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Дата поставки <input type="date" name="request_date" value="{{ 'now'|date('Y-m-d') }}" required></label>
          <label>Статус
            <select name="status">
              <option value="В пути">В пути</option>
              <option value="Получено">Получено</option>
            </select>
          </label>
        </div>
        <div>
          <div class="table-actions" style="justify-content:space-between;margin-bottom:8px">
            <strong>Продукты</strong>
            <button class="btn ghost" type="button" onclick="addProductRow()">Добавить продукт</button>
          </div>
          <div id="product-lines" class="line-items">
            <div class="line-item">
              <select name="product_id[]" required>
                {% for product in products %}
                  <option value="{{ product.product_id }}">{{ product.product_name }}</option>
                {% endfor %}
              </select>
              <input name="products_number[]" type="number" min="0.01" step="0.01" value="10" required>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn secondary" type="button" onclick="closeModal('create-request')">Отмена</button>
        <button class="btn" type="submit">Создать</button>
      </div>
    </form>
  </dialog>

  <template id="product-template">
    <div class="line-item">
      <select name="product_id[]" required>
        {% for product in products %}
          <option value="{{ product.product_id }}">{{ product.product_name }}</option>
        {% endfor %}
      </select>
      <input name="products_number[]" type="number" min="0.01" step="0.01" value="10" required>
    </div>
  </template>
{% endblock %}
