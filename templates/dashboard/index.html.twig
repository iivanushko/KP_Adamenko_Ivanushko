{% extends 'base.html.twig' %}

{% block title %}Панель управления{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Панель управления</h1>
      <div class="muted">Оперативное состояние заказов и склада</div>
    </div>
    <a class="btn" href="{{ path('orders_index') }}">Открыть заказы</a>
  </div>

  <section class="grid stats">
    <div class="card stat"><div class="muted">Всего заказов</div><div class="value">{{ summary.orders_total }}</div></div>
    <div class="card stat"><div class="muted">Активные заказы</div><div class="value">{{ summary.active_orders }}</div></div>
    <div class="card stat">
      <div class="muted">Выручка (выполненные)</div>
      <div class="value">{{ summary.revenue|number_format(0, ',', ' ') }} руб.</div>
      {% if summary.revenue_forecast > 0 %}
        <div class="muted" style="margin-top:4px;font-size:0.8em;">
          + {{ summary.revenue_forecast|number_format(0, ',', ' ') }} руб. прогноз
        </div>
      {% endif %}
    </div>
    <div class="card stat"><div class="muted">Низкие остатки</div><div class="value">{{ summary.low_stock }}</div></div>
  </section>

  <section class="card" style="margin-top:16px;">
    <h2>Выручка по месяцам (последние 6 месяцев)</h2>
    {% if chart_data|length > 0 %}
      <div style="position:relative;height:260px;margin-top:12px;">
        <canvas id="revenueChart"></canvas>
      </div>
    {% else %}
      <div class="muted" style="margin-top:12px;">Нет данных о выручке за последние месяцы.</div>
    {% endif %}
  </section>

  <section class="grid two" style="margin-top:16px">
    <div class="card">
      <h2>Ближайшие мероприятия</h2>
      <table>
        <thead><tr><th>Дата</th><th>Клиент</th><th>Тип</th><th>Статус</th><th>Стоимость</th></tr></thead>
        <tbody>
        {% for order in upcoming %}
          <tr>
            <td>{{ order.event_date }}</td>
            <td>{{ order.client_full_name }}</td>
            <td>{{ order.event_type }}</td>
            <td><span class="pill warn">{{ order.status }}</span></td>
            <td>{{ order.total_cost|number_format(2, ',', ' ') }} руб.</td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="muted">Активных мероприятий пока нет</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="card">
      <h2>Журнал операций</h2>
      {% set op_labels = {
        'CREATE':        'Создание',
        'UPDATE':        'Обновление',
        'UPDATE_STATUS': 'Смена статуса',
        'UPDATE_DISHES': 'Состав заказа',
        'DELETE':        'Удаление',
        'CLOSE_RESERVE': 'Возврат резерва',
        'NOTIFICATION':  'Уведомление',
        'SEED':          'Демо-данные'
      } %}
      <table style="table-layout:fixed">
        <colgroup>
          <col style="width:140px">
          <col style="width:110px">
          <col>
        </colgroup>
        <thead><tr><th>Время</th><th>Операция</th><th>Описание</th></tr></thead>
        <tbody>
        {% for log in logs %}
          <tr>
            <td>{{ log.operation_date }}</td>
            <td>{{ op_labels[log.operation_type] ?? log.operation_type }}</td>
            <td title="{{ log.description }}" style="word-break:break-word">{{ log.description }}</td>
          </tr>
        {% else %}
          <tr><td colspan="3" class="muted">Журнал заполнится после изменений</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  {% if chart_data|length > 0 %}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script>
    (function () {
      var raw = {{ chart_data|json_encode|raw }};

      var labels   = raw.map(function(d) { return d.month; });
      var revenues = raw.map(function(d) { return d.revenue; });
      var forecasts = raw.map(function(d) { return d.forecast; });

      function fmtRub(v) {
        if (v >= 1000000) return (v / 1000000).toFixed(1).replace('.', ',') + ' млн';
        if (v >= 1000)    return Math.round(v / 1000) + ' тыс.';
        return Math.round(v) + ' ₽';
      }

      var ctx = document.getElementById('revenueChart').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Выполнено',
              data: revenues,
              backgroundColor: 'rgba(79, 175, 80, 0.85)',
              borderColor:     'rgba(55, 140, 55, 1)',
              borderWidth: 1,
              borderRadius: 4,
              stack: 'revenue'
            },
            {
              label: 'Прогноз',
              data: forecasts,
              backgroundColor: 'rgba(255, 193, 7, 0.65)',
              borderColor:     'rgba(200, 150, 0, 1)',
              borderWidth: 1,
              borderRadius: 4,
              stack: 'revenue'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: {
              position: 'top',
              labels: { font: { size: 13 }, padding: 16 }
            },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  return ' ' + ctx.dataset.label + ': ' + fmtRub(ctx.parsed.y);
                },
                footer: function(items) {
                  var total = items.reduce(function(s, i) { return s + i.parsed.y; }, 0);
                  return total > 0 ? 'Итого: ' + fmtRub(total) : '';
                }
              }
            }
          },
          scales: {
            x: {
              stacked: true,
              grid: { display: false },
              ticks: { font: { size: 12 } }
            },
            y: {
              stacked: true,
              beginAtZero: true,
              ticks: {
                font: { size: 12 },
                callback: function(v) { return fmtRub(v); }
              },
              grid: { color: 'rgba(0,0,0,0.06)' }
            }
          }
        }
      });
    })();
  </script>
  {% endif %}
{% endblock %}
