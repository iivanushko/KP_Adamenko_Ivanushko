<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Кейтеринг{% endblock %}</title>
  <style>
    :root {
      --bg: #f6f7f9;
      --panel: #ffffff;
      --ink: #1e293b;
      --muted: #64748b;
      --line: #d8dee8;
      --brand: #0f766e;
      --brand-dark: #115e59;
      --accent: #b45309;
      --danger: #b91c1c;
      --ok: #15803d;
      --soft: #eef7f5;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, Helvetica, sans-serif; color: var(--ink); background: var(--bg); }
    a { color: inherit; text-decoration: none; }
    .layout { display: grid; grid-template-columns: 260px 1fr; min-height: 100vh; }
    .sidebar { background: #102a2a; color: white; padding: 22px 18px; }
    .brand { font-size: 22px; font-weight: 700; margin-bottom: 26px; }
    .nav { display: grid; gap: 8px; }
    .nav a { padding: 11px 12px; border-radius: 8px; color: #d7eeee; }
    .nav a:hover, .nav a.active { background: rgba(255,255,255,.12); color: white; }
    main { padding: 28px; min-width: 0; }
    .topline { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
    h1 { margin: 0; font-size: 28px; letter-spacing: 0; }
    h2 { margin: 0 0 14px; font-size: 20px; letter-spacing: 0; }
    .muted { color: var(--muted); }
    .grid { display: grid; gap: 16px; }
    .stats { grid-template-columns: repeat(4, minmax(160px, 1fr)); }
    .two { grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr); }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 18px; }
    .stat .value { font-size: 28px; font-weight: 700; margin-top: 8px; }
    .toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin-bottom: 14px; }
    label { display: grid; gap: 6px; font-size: 13px; color: var(--muted); }
    input, select { min-height: 38px; border: 1px solid var(--line); border-radius: 7px; padding: 8px 10px; background: white; color: var(--ink); }
    input[type="checkbox"] { min-height: auto; }
    .btn { border: 0; border-radius: 7px; padding: 10px 13px; background: var(--brand); color: white; cursor: pointer; font-weight: 700; }
    .btn:hover { background: var(--brand-dark); }
    .btn.secondary { background: #e2e8f0; color: var(--ink); }
    .btn.danger { background: var(--danger); }
    .btn.ghost { background: transparent; color: var(--brand); border: 1px solid var(--brand); }
    table { width: 100%; border-collapse: collapse; background: white; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    th, td { padding: 12px 10px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
    th { font-size: 12px; text-transform: uppercase; color: var(--muted); background: #f8fafc; }
    tr:last-child td { border-bottom: 0; }
    .table-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .inline-form { display: flex; gap: 6px; align-items: center; }
    .inline-form input { width: 110px; }
    .inline-fields { display: grid; grid-template-columns: 110px 110px auto; gap: 8px; align-items: end; }
    .inline-fields label { font-size: 12px; }
    .checkline { display: flex; grid-template-columns: none; align-items: center; gap: 8px; color: var(--ink); }
    .sort-link { color: var(--muted); font-weight: 700; }
    .sort-link.active { color: var(--brand); }
    .pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 4px 8px; font-size: 12px; font-weight: 700; background: #e2e8f0; }
    .pill.ok { background: #dcfce7; color: var(--ok); }
    .pill.warn { background: #fef3c7; color: var(--accent); }
    .pill.danger { background: #fee2e2; color: var(--danger); }
    .flash { padding: 12px 14px; border-radius: 8px; margin-bottom: 14px; border: 1px solid; }
    .flash.success { background: #ecfdf5; border-color: #86efac; }
    .flash.danger { background: #fef2f2; border-color: #fecaca; }
    .pagination { display: flex; gap: 8px; margin-top: 14px; align-items: center; }
    .pagination a, .pagination span { padding: 8px 10px; border-radius: 7px; border: 1px solid var(--line); background: white; }
    dialog { border: 0; border-radius: 8px; padding: 0; width: min(760px, calc(100vw - 30px)); box-shadow: 0 24px 80px rgba(15, 23, 42, .3); }
    dialog::backdrop { background: rgba(15, 23, 42, .45); }
    .modal-head, .modal-foot { padding: 16px 18px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .modal-foot { border-top: 1px solid var(--line); border-bottom: 0; justify-content: flex-end; }
    .modal-body { padding: 18px; display: grid; gap: 14px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .wide { grid-column: 1 / -1; }
    .line-items { display: grid; gap: 8px; }
    .line-item { display: grid; grid-template-columns: 1fr 130px; gap: 8px; }
    .bar { height: 28px; background: var(--soft); border-radius: 6px; overflow: hidden; border: 1px solid #cce7e2; }
    .bar span { display: block; height: 100%; background: var(--brand); }
    .switch { display: inline-flex; width: 46px; height: 24px; position: relative; }
    .switch input { position: absolute; opacity: 0; }
    .switch span { position: absolute; inset: 0; border-radius: 999px; background: #cbd5e1; cursor: pointer; transition: .15s; }
    .switch span::before { content: ""; position: absolute; width: 18px; height: 18px; left: 3px; top: 3px; border-radius: 50%; background: white; transition: .15s; box-shadow: 0 1px 3px rgba(15,23,42,.25); }
    .switch input:checked + span { background: var(--brand); }
    .switch input:checked + span::before { transform: translateX(22px); }
    @media (max-width: 900px) {
      .layout { grid-template-columns: 1fr; }
      .sidebar { position: static; }
      .stats, .two, .form-grid { grid-template-columns: 1fr; }
      .inline-fields { grid-template-columns: 1fr; }
      main { padding: 18px; }
      table { display: block; overflow-x: auto; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      {% set route = app.request.attributes.get('_route') ?? '' %}
      <div class="brand">Кейтеринг</div>
      <nav class="nav">
        <a class="{% if route == 'dashboard' %}active{% endif %}" href="{{ path('dashboard') }}">Панель</a>
        <a class="{% if route starts with 'orders_' %}active{% endif %}" href="{{ path('orders_index') }}">Банкетные заказы</a>
        <a class="{% if route starts with 'clients_' %}active{% endif %}" href="{{ path('clients_index') }}">Клиенты</a>
        <a class="{% if route starts with 'menu_' %}active{% endif %}" href="{{ path('menu_index') }}">Меню/Блюда</a>
        <a class="{% if route starts with 'references_' %}active{% endif %}" href="{{ path('references_index') }}">Справочники</a>
        <a class="{% if route starts with 'warehouse_' %}active{% endif %}" href="{{ path('warehouse_index') }}">Склад и поставки</a>
        <a class="{% if route starts with 'reports_' %}active{% endif %}" href="{{ path('reports_orders') }}">Отчеты</a>
      </nav>
    </aside>
    <main>
      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="flash {{ type }}">{{ message }}</div>
        {% endfor %}
      {% endfor %}
      {% block body %}{% endblock %}
    </main>
  </div>
  <script>
    function openModal(id) { document.getElementById(id).showModal(); }
    function closeModal(id) { document.getElementById(id).close(); }
    function addDishRow() {
      const source = document.querySelector('#dish-template').content.cloneNode(true);
      document.querySelector('#dish-lines').appendChild(source);
    }
    function addProductRow() {
      const source = document.querySelector('#product-template').content.cloneNode(true);
      document.querySelector('#product-lines').appendChild(source);
    }
    function confirmStatusChange(select) {
      if (select.value === select.dataset.current) return;
      const finalText = select.value === 'Выполнен'
        ? 'Перевести заказ в статус "Выполнен"? После этого отмена заказа будет недоступна.'
        : 'Изменить статус заказа на "' + select.value + '"?';
      if (confirm(finalText)) {
        select.form.submit();
      } else {
        select.value = select.dataset.current;
      }
    }
    document.addEventListener('submit', function (event) {
      let invalid = null;
      event.target.querySelectorAll('[data-future-date]').forEach(function (input) {
        input.setCustomValidity('');
        if (input.value && input.min && input.value < input.min) {
          input.setCustomValidity('Дата активного заказа не может быть в прошлом.');
          invalid = invalid || input;
        }
      });
      if (invalid) {
        event.preventDefault();
        invalid.reportValidity();
      }
    });
  </script>
</body>
</html>
