{% extends 'base.html.twig' %}

{% block title %}Банкетные заказы{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Банкетные заказы</h1>
      <div class="muted">Создание заказа резервирует продукты на складе через хранимую процедуру</div>
    </div>
    <button class="btn" type="button" onclick="openModal('create-order')">Новый заказ</button>
  </div>

  <form class="toolbar" method="get">
    <label>Клиент или телефон
      <input name="q" value="{{ filters.q }}" placeholder="ФИО или телефон">
    </label>
    <label>Статус
      <select name="status">
        <option value="">Все</option>
        {% for status in statuses %}
          <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status }}</option>
        {% endfor %}
      </select>
    </label>
    <label>Тип мероприятия
      <select name="event_type">
        <option value="">Все</option>
        {% for type in event_types %}
          <option value="{{ type }}" {% if filters.event_type == type %}selected{% endif %}>{{ type }}</option>
        {% endfor %}
      </select>
    </label>
    <label>С даты <input type="date" name="date_from" value="{{ filters.date_from }}"></label>
    <label>По дату <input type="date" name="date_to" value="{{ filters.date_to }}"></label>
    <button class="btn" type="submit">Найти</button>
    <a class="btn secondary" href="{{ path('orders_index') }}">Сброс</a>
  </form>

  <table>
    <thead>
      <tr>
        <th><a class="sort-link {% if filters.sort == 'date' %}active{% endif %}" href="{{ path('orders_index', filters|merge({sort: 'date', direction: filters.sort == 'date' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Дата</a></th>
        <th><a class="sort-link {% if filters.sort == 'client' %}active{% endif %}" href="{{ path('orders_index', filters|merge({sort: 'client', direction: filters.sort == 'client' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Клиент</a></th>
        <th><a class="sort-link {% if filters.sort == 'manager' %}active{% endif %}" href="{{ path('orders_index', filters|merge({sort: 'manager', direction: filters.sort == 'manager' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Менеджер</a></th>
        <th>Блюда</th>
        <th><a class="sort-link {% if filters.sort == 'cost' %}active{% endif %}" href="{{ path('orders_index', filters|merge({sort: 'cost', direction: filters.sort == 'cost' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Стоимость</a></th>
        <th><a class="sort-link {% if filters.sort == 'status' %}active{% endif %}" href="{{ path('orders_index', filters|merge({sort: 'status', direction: filters.sort == 'status' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Статус</a></th>
        <th><a class="sort-link {% if filters.sort == 'prepayment' %}active{% endif %}" href="{{ path('orders_index', filters|merge({sort: 'prepayment', direction: filters.sort == 'prepayment' and filters.direction == 'asc' ? 'desc' : 'asc', page: 1})) }}">Предоплата</a></th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
    {% for order in result.items %}
      <tr>
        <td>{{ order.event_date }}<br><span class="muted">{{ order.event_type }}</span></td>
        <td>{{ order.client_full_name }}<br><span class="muted">{{ order.phone_number }}</span></td>
        <td>{{ order.manager_full_name }}</td>
        <td>
          <details>
            <summary>{{ order.dishes }}</summary>
            <table style="margin-top:8px">
              <thead><tr><th>Блюдо</th><th>Порций</th><th>Цена</th><th>Сумма</th></tr></thead>
              <tbody>
              {% for detail in order_details[order.order_id] ?? [] %}
                <tr>
                  <td>{{ detail.dish_name }}</td>
                  <td>{{ detail.serving_number|number_format(0, ',', ' ') }}</td>
                  <td>{{ detail.sale_price|number_format(2, ',', ' ') }} руб.</td>
                  <td>{{ detail.line_total|number_format(2, ',', ' ') }} руб.</td>
                </tr>
              {% else %}
                <tr><td colspan="4" class="muted">Детализация не найдена</td></tr>
              {% endfor %}
              </tbody>
            </table>
          </details>
        </td>
        <td>{{ order.total_cost|number_format(2, ',', ' ') }} руб.<br>
          {% if order.is_fully_paid %}<span class="pill ok" title="Рассчитывается автоматически по предоплате и стоимости заказа">Оплачен</span>{% else %}<span class="pill warn" title="Рассчитывается автоматически по предоплате и стоимости заказа">Ожидает оплаты</span>{% endif %}
        </td>
        <td>
          <form class="inline-form" method="post" action="{{ path('orders_inline', {id: order.order_id}) }}">
            <input type="hidden" name="field" value="status">
            <select name="value" data-current="{{ order.status }}" onchange="confirmStatusChange(this)" {% if order.status == 'Отменен' %}disabled{% endif %}>
              {% for status in statuses %}
                <option value="{{ status }}" {% if order.status == status %}selected{% endif %}>{{ status }}</option>
              {% endfor %}
            </select>
          </form>
        </td>
        <td>
          <form class="inline-form" method="post" action="{{ path('orders_inline', {id: order.order_id}) }}">
            <input type="hidden" name="field" value="prepayment_amount">
            <input name="value" type="number" min="0" step="0.01" value="{{ order.prepayment_amount }}" {% if order.status == 'Отменен' %}disabled{% endif %}>
            <button class="btn secondary" type="submit" {% if order.status == 'Отменен' %}disabled{% endif %}>OK</button>
          </form>
        </td>
        <td>
          <div class="table-actions">
            <a class="btn ghost" href="{{ path('orders_history', {id: order.order_id}) }}">История</a>
            <button class="btn secondary" type="button" onclick="openModal('edit-order-{{ order.order_id }}')">Изменить</button>
            {% if order.status not in ['Отменен', 'Выполнен'] %}
              <form method="post" action="{{ path('orders_cancel', {id: order.order_id}) }}" onsubmit="return confirm('Отменить заказ и вернуть продукты на склад?')">
                <button class="btn danger" type="submit">Отменить</button>
              </form>
            {% endif %}
          </div>
        </td>
      </tr>

      <dialog id="edit-order-{{ order.order_id }}">
        <form method="post" action="{{ path('orders_edit', {id: order.order_id}) }}">
          <div class="modal-head">
            <h2>Редактирование заказа</h2>
            <button class="btn secondary" type="button" onclick="closeModal('edit-order-{{ order.order_id }}')">Закрыть</button>
          </div>
          <div class="modal-body form-grid">
            <label>Клиент
              <select name="client_id" required>
                {% for client in clients %}
                  <option value="{{ client.client_id }}" {% if client.client_id == order.client_id %}selected{% endif %}>{{ client.client_full_name }} · {{ client.phone_number }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Менеджер
              <select name="manager_id" required>
                {% for manager in managers %}
                  <option value="{{ manager.manager_id }}" {% if manager.manager_id == order.manager_id %}selected{% endif %}>{{ manager.manager_full_name }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Дата мероприятия <input type="date" name="event_date" value="{{ order.event_date }}" min="{{ 'now'|date('Y-m-d') }}" {% if order.status not in ['Выполнен', 'Отменен'] %}data-future-date{% endif %} required></label>
            <label>Тип мероприятия
              <select name="event_type">
                {% for type in event_types %}
                  <option value="{{ type }}" {% if type == order.event_type %}selected{% endif %}>{{ type }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Статус
              <select name="status">
                {% for status in statuses %}
                  <option value="{{ status }}" {% if status == order.status %}selected{% endif %}>{{ status }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Предоплата <input type="number" min="0" step="0.01" name="prepayment_amount" value="{{ order.prepayment_amount }}"></label>
            <div class="wide">
              <div class="table-actions" style="justify-content:space-between;margin-bottom:8px">
                <strong>Блюда и порции</strong>
                {% if order.status not in ['Выполнен', 'Отменен'] %}
                  <button class="btn ghost" type="button" onclick="addDishRow('edit-dish-lines-{{ order.order_id }}')">Добавить блюдо</button>
                {% endif %}
              </div>
              {% if order.status in ['Выполнен', 'Отменен'] %}
                <div class="muted">Состав выполненных и отмененных заказов не редактируется, чтобы история и складские резервы не расходились.</div>
              {% else %}
                <div id="edit-dish-lines-{{ order.order_id }}" class="line-items">
                  {% for detail in order_details[order.order_id] ?? [] %}
                    <div class="line-item">
                      <select name="dish_id[]" required>
                        <option value="{{ detail.dish_id }}" selected>{{ detail.dish_name }} · текущее блюдо</option>
                        {% for dish in dishes %}
                          {% if dish.dish_id != detail.dish_id %}
                            <option value="{{ dish.dish_id }}">{{ dish.dish_name }} · {{ dish.sale_price|number_format(2, ',', ' ') }} руб. · {{ dish.price_category }}</option>
                          {% endif %}
                        {% endfor %}
                      </select>
                      <input name="quantity[]" type="number" min="1" step="1" value="{{ detail.serving_number|number_format(0, '.', '') }}" required>
                      <button class="btn secondary" type="button" onclick="removeLine(this)">Удалить</button>
                    </div>
                  {% else %}
                    <div class="line-item">
                      <select name="dish_id[]" required>
                        {% for dish in dishes %}
                          <option value="{{ dish.dish_id }}">{{ dish.dish_name }} · {{ dish.sale_price|number_format(2, ',', ' ') }} руб. · {{ dish.price_category }}</option>
                        {% endfor %}
                      </select>
                      <input name="quantity[]" type="number" min="1" step="1" value="1" required>
                      <button class="btn secondary" type="button" onclick="removeLine(this)">Удалить</button>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
          <div class="modal-foot">
            <button class="btn secondary" type="button" onclick="closeModal('edit-order-{{ order.order_id }}')">Отмена</button>
            <button class="btn" type="submit">Сохранить</button>
          </div>
        </form>
      </dialog>
    {% else %}
      <tr><td colspan="8" class="muted">Заказы по выбранным условиям не найдены</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <div class="pagination">
    {% if page > 1 %}
      <a href="{{ path('orders_index', filters|merge({page: page - 1})) }}">Назад</a>
    {% endif %}
    <span>Страница {{ page }} из {{ result.pages }}</span>
    {% if page < result.pages %}
      <a href="{{ path('orders_index', filters|merge({page: page + 1})) }}">Вперед</a>
    {% endif %}
  </div>

  <dialog id="create-order">
    <form method="post" action="{{ path('orders_create') }}">
      <div class="modal-head">
        <h2>Новый банкетный заказ</h2>
        <button class="btn secondary" type="button" onclick="closeModal('create-order')">Закрыть</button>
      </div>
      <div class="modal-body">
        <div class="form-grid">
          <label>Клиент
            <select name="client_id" required>
              {% for client in clients %}
                <option value="{{ client.client_id }}">{{ client.client_full_name }} · {{ client.phone_number }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Менеджер
            <select name="manager_id" required>
              {% for manager in managers %}
                <option value="{{ manager.manager_id }}">{{ manager.manager_full_name }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Дата мероприятия <input type="date" name="event_date" min="{{ 'now'|date('Y-m-d') }}" data-future-date required></label>
          <label>Тип мероприятия
            <select name="event_type" required>
              {% for type in event_types %}
                <option value="{{ type }}">{{ type }}</option>
              {% endfor %}
            </select>
          </label>
        </div>
        <div>
          <div class="table-actions" style="justify-content:space-between;margin-bottom:8px">
            <strong>Блюда и порции</strong>
            <button class="btn ghost" type="button" onclick="addDishRow()">Добавить блюдо</button>
          </div>
          <div id="dish-lines" class="line-items">
            <div class="line-item">
              <select name="dish_id[]" required>
                {% for dish in dishes %}
                  <option value="{{ dish.dish_id }}">{{ dish.dish_name }} · {{ dish.sale_price|number_format(2, ',', ' ') }} руб. · {{ dish.price_category }}</option>
                {% endfor %}
              </select>
              <input name="quantity[]" type="number" min="1" step="1" value="1" required>
              <button class="btn secondary" type="button" onclick="removeLine(this)">Удалить</button>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn secondary" type="button" onclick="closeModal('create-order')">Отмена</button>
        <button class="btn" type="submit">Создать</button>
      </div>
    </form>
  </dialog>

  <template id="dish-template">
    <div class="line-item">
      <select name="dish_id[]" required>
        {% for dish in dishes %}
          <option value="{{ dish.dish_id }}">{{ dish.dish_name }} · {{ dish.sale_price|number_format(2, ',', ' ') }} руб. · {{ dish.price_category }}</option>
        {% endfor %}
      </select>
      <input name="quantity[]" type="number" min="1" step="1" value="1" required>
      <button class="btn secondary" type="button" onclick="removeLine(this)">Удалить</button>
    </div>
  </template>
{% endblock %}
