{% extends 'base.html.twig' %}

{% block title %}Отчет по прибыльности блюд{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Отчет по прибыльности блюд</h1>
      <div class="muted">Сводка по проданным блюдам и их вкладу в общую прибыль</div>
    </div>
    <div class="table-actions">
      <a class="btn ghost" href="{{ path('reports_orders') }}">Заказы</a>
      <a class="btn ghost" href="{{ path('reports_warehouse') }}">Склад и поставки</a>
    </div>
  </div>

  <form class="toolbar" method="get">
    <label>С даты <input type="date" name="date_from" value="{{ filters.date_from }}"></label>
    <label>По дату <input type="date" name="date_to" value="{{ filters.date_to }}"></label>
    <label>Менеджер
      <select name="manager_id">
        <option value="">Все</option>
        {% for manager in managers %}
          <option value="{{ manager.manager_id }}" {% if filters.manager_id == manager.manager_id ~ '' %}selected{% endif %}>{{ manager.manager_full_name }}</option>
        {% endfor %}
      </select>
    </label>
    <label>Категория
      <select name="price_category">
        <option value="">Все</option>
        {% for category in price_categories %}
          <option value="{{ category }}" {% if filters.price_category == category %}selected{% endif %}>{{ category }}</option>
        {% endfor %}
      </select>
    </label>
    <button class="btn" type="submit">Сформировать</button>
    <a class="btn secondary" href="{{ path('reports_profitability') }}">Сброс</a>
  </form>

  <section class="grid stats" style="margin-bottom: 16px;">
    <div class="card stat"><div class="muted">Блюд в отчете</div><div class="value">{{ report|length }}</div></div>
    <div class="card stat"><div class="muted">Продано порций</div><div class="value">{{ total_sold|number_format(0, ',', ' ') }}</div></div>
    <div class="card stat"><div class="muted">Общая прибыль</div><div class="value">{{ total_overall_profit|number_format(2, ',', ' ') }} руб.</div></div>
  </section>

  <table>
    <thead>
      <tr>
        <th>Название блюда</th>
        <th>Категория</th>
        <th>Себестоимость</th>
        <th>Цена продажи</th>
        <th>Прибыль (1 шт.)</th>
        <th>Продано порций</th>
        <th>Суммарная прибыль</th>
      </tr>
    </thead>
    <tbody>
      {% for item in report %}
        <tr>
          <td>{{ item.dish_name }}</td>
          <td>{{ item.price_category|default('-') }}</td>
          <td>{{ item.cost_price|number_format(2, ',', ' ') }} руб.</td>
          <td>{{ item.sale_price|number_format(2, ',', ' ') }} руб.</td>
          <td>{{ item.profit|number_format(2, ',', ' ') }} руб.</td>
          <td>{{ item.total_sold }}</td>
          <td><strong>{{ item.total_profit|number_format(2, ',', ' ') }} руб.</strong></td>
        </tr>
      {% else %}
        <tr>
          <td colspan="7" class="muted">Данные отсутствуют</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock %}
