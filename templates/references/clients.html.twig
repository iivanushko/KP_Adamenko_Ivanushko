{% extends 'base.html.twig' %}

{% block title %}Клиенты{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Клиенты</h1>
      <div class="muted">Справочник клиентов для банкетных заказов</div>
    </div>
    <button class="btn" type="button" onclick="openModal('create-client')">Новый клиент</button>
  </div>

  <table>
    <thead>
      <tr><th>ФИО</th><th>Телефон</th><th>Действия</th></tr>
    </thead>
    <tbody>
    {% for client in clients %}
      <tr>
        <td>{{ client.client_full_name }}</td>
        <td>{{ client.phone_number }}</td>
        <td>
          <div class="table-actions">
            <button class="btn secondary" type="button" onclick="openModal('edit-client-{{ client.client_id }}')">Изменить</button>
            <form method="post" action="{{ path('clients_delete', {id: client.client_id}) }}" onsubmit="return confirm('Удалить клиента? Если у него есть заказы, удаление будет запрещено.')">
              <button class="btn danger" type="submit">Удалить</button>
            </form>
          </div>
        </td>
      </tr>

      <dialog id="edit-client-{{ client.client_id }}">
        <form method="post" action="{{ path('clients_edit', {id: client.client_id}) }}">
          <div class="modal-head">
            <h2>Редактирование клиента</h2>
            <button class="btn secondary" type="button" onclick="closeModal('edit-client-{{ client.client_id }}')">Закрыть</button>
          </div>
          <div class="modal-body form-grid">
            <label>ФИО <input name="client_full_name" value="{{ client.client_full_name }}" maxlength="100" required></label>
            <label>Телефон <input name="phone_number" value="{{ client.phone_number }}" maxlength="20" required></label>
          </div>
          <div class="modal-foot">
            <button class="btn secondary" type="button" onclick="closeModal('edit-client-{{ client.client_id }}')">Отмена</button>
            <button class="btn" type="submit">Сохранить</button>
          </div>
        </form>
      </dialog>
    {% else %}
      <tr><td colspan="3" class="muted">Клиенты пока не добавлены</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <dialog id="create-client">
    <form method="post" action="{{ path('clients_create') }}">
      <div class="modal-head">
        <h2>Новый клиент</h2>
        <button class="btn secondary" type="button" onclick="closeModal('create-client')">Закрыть</button>
      </div>
      <div class="modal-body form-grid">
        <label>ФИО <input name="client_full_name" maxlength="100" required></label>
        <label>Телефон <input name="phone_number" maxlength="20" required></label>
      </div>
      <div class="modal-foot">
        <button class="btn secondary" type="button" onclick="closeModal('create-client')">Отмена</button>
        <button class="btn" type="submit">Создать</button>
      </div>
    </form>
  </dialog>
{% endblock %}
