{% extends 'base.html.twig' %}

{% block title %}Клиенты{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Клиенты</h1>
      <div class="page-subtitle">Справочник клиентов для банкетных заказов</div>
    </div>
    <button class="btn" type="button" onclick="openModal('create-client')">Новый клиент</button>
  </div>

  <form class="toolbar" method="get">
    <label>Клиент или телефон
      <input name="q" value="{{ filters.q }}" placeholder="ФИО или телефон">
    </label>
    <button class="btn" type="submit">Найти</button>
    <a class="btn secondary" href="{{ path('clients_index') }}">Сброс</a>
  </form>

  <div class="table-wrap">
  <table id="clients-table" class="sortable-table">
    <thead>
      <tr>
        <th data-col="0" class="sort-th">ФИО <span class="sort-icon">⇕</span></th>
        <th data-col="1" class="sort-th">Телефон <span class="sort-icon">⇕</span></th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
    {% for client in result.items %}
      <tr>
        <td data-val="{{ client.client_full_name }}">
          <form id="client-form-{{ client.client_id }}" method="post" action="{{ path('clients_edit', {id: client.client_id}) }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('default') }}">
            <input type="hidden" name="_redirect" value="{{ path('clients_index', filters|merge({page: page})) }}">
          </form>
          <input form="client-form-{{ client.client_id }}" name="client_full_name" value="{{ client.client_full_name }}" maxlength="100" required>
        </td>
        <td data-val="{{ client.phone_number }}"><input form="client-form-{{ client.client_id }}" name="phone_number" value="{{ client.phone_number }}" maxlength="20" pattern="[0-9]{10,15}" title="От 10 до 15 цифр" required></td>
        <td>
          <div class="table-actions">
            <button form="client-form-{{ client.client_id }}" class="btn secondary" type="submit">Сохранить</button>
            <button class="btn secondary" type="button" onclick="openModal('edit-client-{{ client.client_id }}')">Редактировать</button>
            <form method="post" action="{{ path('clients_delete', {id: client.client_id}) }}" onsubmit="return confirm('Удалить клиента? Если у него есть заказы, удаление будет запрещено.')">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('default') }}">
              <input type="hidden" name="_redirect" value="{{ path('clients_index', filters|merge({page: page})) }}">
              <button class="btn danger" type="submit">Удалить</button>
            </form>
          </div>
        </td>
      </tr>

      <dialog id="edit-client-{{ client.client_id }}">
        <form method="post" action="{{ path('clients_edit', {id: client.client_id}) }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('default') }}">
          <input type="hidden" name="_redirect" value="{{ path('clients_index', filters|merge({page: page})) }}">
          <div class="modal-head">
            <h2>Редактирование клиента</h2>
            <button class="btn secondary" type="button" onclick="closeModal('edit-client-{{ client.client_id }}')">Закрыть</button>
          </div>
          <div class="modal-body form-grid">
            <label>ФИО <input name="client_full_name" value="{{ client.client_full_name }}" maxlength="100" required></label>
            <label>Телефон <input name="phone_number" value="{{ client.phone_number }}" maxlength="20" pattern="[0-9]{10,15}" title="От 10 до 15 цифр" required></label>
          </div>
          <div class="modal-foot">
            <button class="btn secondary" type="button" onclick="closeModal('edit-client-{{ client.client_id }}')">Отмена</button>
            <button class="btn" type="submit">Сохранить</button>
          </div>
        </form>
      </dialog>
    {% else %}
      <tr><td colspan="3" class="muted">Клиенты пока не добавлены</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  <div class="pagination">
    {% if page > 1 %}
      <a href="{{ path('clients_index', filters|merge({page: 1})) }}" title="В начало">&#171; В начало</a>
      <a href="{{ path('clients_index', filters|merge({page: page - 1})) }}">&#8249; Назад</a>
    {% endif %}
    <span>Стр. {{ page }} из {{ result.pages }}</span>
    <span class="pg-info">Всего: {{ result.total }} зап.</span>
    {% if page < result.pages %}
      <a href="{{ path('clients_index', filters|merge({page: page + 1})) }}">Вперед &#8250;</a>
      <a href="{{ path('clients_index', filters|merge({page: result.pages})) }}" title="В конец">В конец &#187;</a>
    {% endif %}
  </div>

  <dialog id="create-client">
    <form method="post" action="{{ path('clients_create') }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('default') }}">
      <div class="modal-head">
        <h2>Новый клиент</h2>
        <button class="btn secondary" type="button" onclick="closeModal('create-client')">Закрыть</button>
      </div>
      <div class="modal-body form-grid">
        <label>ФИО <input name="client_full_name" maxlength="100" required></label>
        <label>Телефон <input name="phone_number" maxlength="20" pattern="[0-9]{10,15}" title="От 10 до 15 цифр" required></label>
      </div>
      <div class="modal-foot">
        <button class="btn secondary" type="button" onclick="closeModal('create-client')">Отмена</button>
        <button class="btn" type="submit">Создать</button>
      </div>
    </form>
  </dialog>
{% endblock %}
