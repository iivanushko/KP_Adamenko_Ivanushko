{% extends 'base.html.twig' %}

{% block title %}Меню и блюда{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Меню и блюда</h1>
      <div class="muted">Блюда для заказов, цены и доступность в меню</div>
    </div>
    <button class="btn" type="button" onclick="openModal('create-dish')">Новое блюдо</button>
  </div>

  <form class="toolbar" method="get">
    <label>Блюдо
      <input name="q" value="{{ filters.q }}" placeholder="Название блюда">
    </label>
    <label>Доступность
      <select name="active">
        <option value="">Все</option>
        <option value="1" {% if filters.active == '1' %}selected{% endif %}>В меню</option>
        <option value="0" {% if filters.active == '0' %}selected{% endif %}>Скрытые</option>
      </select>
    </label>
    <button class="btn" type="submit">Найти</button>
    <a class="btn secondary" href="{{ path('menu_index') }}">Сброс</a>
  </form>

  <table>
    <thead>
      <tr>
        <th>Блюдо</th>
        <th>Себестоимость</th>
        <th>Цена</th>
        <th>Категория</th>
        <th>Прибыль</th>
        <th>Сезонность</th>
        <th>Рецептура</th>
        <th>В меню</th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
    {% for dish in result.items %}
      <tr>
        <td>
          <form id="dish-form-{{ dish.dish_id }}" method="post" action="{{ path('menu_edit', {id: dish.dish_id}) }}"></form>
          <input form="dish-form-{{ dish.dish_id }}" name="dish_name" value="{{ dish.dish_name }}" maxlength="100" required>
        </td>
        <td><input form="dish-form-{{ dish.dish_id }}" name="cost_price" type="number" min="0" step="0.01" value="{{ dish.cost_price }}" required></td>
        <td><input form="dish-form-{{ dish.dish_id }}" name="sale_price" type="number" min="0.01" step="0.01" value="{{ dish.sale_price }}" required></td>
        <td>{{ dish.price_category }}</td>
        <td>{{ dish.profit|number_format(2, ',', ' ') }} руб.</td>
        <td><input form="dish-form-{{ dish.dish_id }}" name="seasonality" value="{{ dish.seasonality }}" maxlength="50"></td>
        <td>
          <button class="btn secondary" type="button" onclick="openModal('recipe-{{ dish.dish_id }}')">Открыть</button>
          <span class="muted">{{ (recipes[dish.dish_id] ?? [])|length }} поз.</span>
        </td>
        <td>
          <form method="post" action="{{ path('menu_toggle', {id: dish.dish_id}) }}">
            <label class="switch" title="Скрытое блюдо не предлагается при создании заказа">
              <input type="checkbox" name="is_active" value="1" onchange="this.form.submit()" {% if dish.is_active %}checked{% endif %}>
              <span></span>
            </label>
          </form>
        </td>
        <td>
          <div class="table-actions">
            <input form="dish-form-{{ dish.dish_id }}" type="hidden" name="is_active" value="{{ dish.is_active ? '1' : '' }}">
            <button form="dish-form-{{ dish.dish_id }}" class="btn secondary" type="submit">Сохранить</button>
            <button class="btn secondary" type="button" onclick="openModal('edit-dish-{{ dish.dish_id }}')">Окно</button>
            <form method="post" action="{{ path('menu_delete', {id: dish.dish_id}) }}" onsubmit="return confirm('Удалить блюдо? Связанные рецепты и строки заказов будут затронуты правилами БД.')">
              <button class="btn danger" type="submit">Удалить</button>
            </form>
          </div>
        </td>
      </tr>

      <dialog id="recipe-{{ dish.dish_id }}">
        <div class="modal-head">
          <h2>Рецептура: {{ dish.dish_name }}</h2>
          <button class="btn secondary" type="button" onclick="closeModal('recipe-{{ dish.dish_id }}')">Закрыть</button>
        </div>
        <div class="modal-body">
          <table>
            <thead><tr><th>Продукт</th><th>Количество на порцию</th><th>Действия</th></tr></thead>
            <tbody>
            {% for row in recipes[dish.dish_id] ?? [] %}
              <tr>
                <td>{{ row.product_name }}</td>
                <td>
                  <form id="recipe-form-{{ dish.dish_id }}-{{ row.product_id }}" method="post" action="{{ path('menu_recipe_save', {id: dish.dish_id}) }}"></form>
                  <input form="recipe-form-{{ dish.dish_id }}-{{ row.product_id }}" type="hidden" name="product_id" value="{{ row.product_id }}">
                  <input form="recipe-form-{{ dish.dish_id }}-{{ row.product_id }}" name="number_in_recipe" type="number" min="0.001" step="0.001" value="{{ row.number_in_recipe }}" required>
                </td>
                <td>
                  <div class="table-actions">
                    <button form="recipe-form-{{ dish.dish_id }}-{{ row.product_id }}" class="btn secondary" type="submit">Сохранить</button>
                    <form method="post" action="{{ path('menu_recipe_delete', {dishId: dish.dish_id, productId: row.product_id}) }}" onsubmit="return confirm('Удалить продукт из рецептуры?')">
                      <button class="btn danger" type="submit">Удалить</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="3" class="muted">Рецептура пока не заполнена</td></tr>
            {% endfor %}
            </tbody>
          </table>
          <form class="toolbar" method="post" action="{{ path('menu_recipe_save', {id: dish.dish_id}) }}">
            <label>Продукт
              <select name="product_id" required>
                {% for product in products %}
                  <option value="{{ product.product_id }}">{{ product.product_name }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Количество на порцию
              <input name="number_in_recipe" type="number" min="0.001" step="0.001" value="0.100" required>
            </label>
            <button class="btn" type="submit">Добавить/обновить</button>
          </form>
        </div>
      </dialog>

      <dialog id="edit-dish-{{ dish.dish_id }}">
        <form method="post" action="{{ path('menu_edit', {id: dish.dish_id}) }}">
          <div class="modal-head">
            <h2>Редактирование блюда</h2>
            <button class="btn secondary" type="button" onclick="closeModal('edit-dish-{{ dish.dish_id }}')">Закрыть</button>
          </div>
          <div class="modal-body form-grid">
            <label>Название <input name="dish_name" value="{{ dish.dish_name }}" maxlength="100" required></label>
            <label>Сезонность <input name="seasonality" value="{{ dish.seasonality }}" maxlength="50"></label>
            <label>Себестоимость <input name="cost_price" type="number" min="0" step="0.01" value="{{ dish.cost_price }}" required></label>
            <label>Цена продажи <input name="sale_price" type="number" min="0.01" step="0.01" value="{{ dish.sale_price }}" required></label>
            <label class="checkline wide"><input type="checkbox" name="is_active" value="1" {% if dish.is_active %}checked{% endif %}> Показывать блюдо при создании заказа</label>
          </div>
          <div class="modal-foot">
            <button class="btn secondary" type="button" onclick="closeModal('edit-dish-{{ dish.dish_id }}')">Отмена</button>
            <button class="btn" type="submit">Сохранить</button>
          </div>
        </form>
      </dialog>
    {% else %}
      <tr><td colspan="9" class="muted">Блюда пока не добавлены</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <div class="pagination">
    {% if page > 1 %}
      <a href="{{ path('menu_index', filters|merge({page: page - 1})) }}">Назад</a>
    {% endif %}
    <span>Страница {{ page }} из {{ result.pages }}</span>
    {% if page < result.pages %}
      <a href="{{ path('menu_index', filters|merge({page: page + 1})) }}">Вперед</a>
    {% endif %}
  </div>

  <dialog id="create-dish">
    <form method="post" action="{{ path('menu_create') }}">
      <div class="modal-head">
        <h2>Новое блюдо</h2>
        <button class="btn secondary" type="button" onclick="closeModal('create-dish')">Закрыть</button>
      </div>
      <div class="modal-body form-grid">
        <label>Название <input name="dish_name" maxlength="100" required></label>
        <label>Сезонность <input name="seasonality" maxlength="50" value="Всесезонное"></label>
        <label>Себестоимость <input name="cost_price" type="number" min="0" step="0.01" required></label>
        <label>Цена продажи <input name="sale_price" type="number" min="0.01" step="0.01" required></label>
        <label class="checkline wide"><input type="checkbox" name="is_active" value="1" checked> Показывать блюдо при создании заказа</label>
      </div>
      <div class="modal-foot">
        <button class="btn secondary" type="button" onclick="closeModal('create-dish')">Отмена</button>
        <button class="btn" type="submit">Создать</button>
      </div>
    </form>
  </dialog>
{% endblock %}
