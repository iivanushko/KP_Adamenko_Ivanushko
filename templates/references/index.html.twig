{% extends 'base.html.twig' %}

{% block title %}Персонал и снабжение{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Персонал и снабжение</h1>
      <div class="muted">Менеджеры, поставщики и продукты для заказов и складских операций</div>
    </div>
  </div>

  <section class="grid two">
    <div class="card">
      <div class="table-actions" style="justify-content:space-between;margin-bottom:12px">
        <h2>Менеджеры</h2>
        <button class="btn" type="button" onclick="openModal('create-manager')">Добавить</button>
      </div>
      <table>
        <thead><tr><th>ФИО</th><th>Действия</th></tr></thead>
        <tbody>
        {% for manager in managers %}
          <tr>
            <td>{{ manager.manager_full_name }}</td>
            <td>
              <div class="table-actions">
                <button class="btn secondary" type="button" onclick="openModal('edit-manager-{{ manager.manager_id }}')">Изменить</button>
                <form method="post" action="{{ path('references_managers_delete', {id: manager.manager_id}) }}" onsubmit="return confirm('Удалить менеджера?')">
                  <button class="btn danger" type="submit">Удалить</button>
                </form>
              </div>
            </td>
          </tr>
          <dialog id="edit-manager-{{ manager.manager_id }}">
            <form method="post" action="{{ path('references_managers_edit', {id: manager.manager_id}) }}">
              <div class="modal-head"><h2>Менеджер</h2><button class="btn secondary" type="button" onclick="closeModal('edit-manager-{{ manager.manager_id }}')">Закрыть</button></div>
              <div class="modal-body"><label>ФИО <input name="manager_full_name" value="{{ manager.manager_full_name }}" maxlength="100" required></label></div>
              <div class="modal-foot"><button class="btn secondary" type="button" onclick="closeModal('edit-manager-{{ manager.manager_id }}')">Отмена</button><button class="btn" type="submit">Сохранить</button></div>
            </form>
          </dialog>
        {% else %}
          <tr><td colspan="2" class="muted">Менеджеры не добавлены</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="table-actions" style="justify-content:space-between;margin-bottom:12px">
        <h2>Поставщики</h2>
        <button class="btn" type="button" onclick="openModal('create-supplier')">Добавить</button>
      </div>
      <table>
        <thead><tr><th>Название</th><th>Действия</th></tr></thead>
        <tbody>
        {% for supplier in suppliers %}
          <tr>
            <td>{{ supplier.supplier_name }}</td>
            <td>
              <div class="table-actions">
                <button class="btn secondary" type="button" onclick="openModal('edit-supplier-{{ supplier.supplier_id }}')">Изменить</button>
                <form method="post" action="{{ path('references_suppliers_delete', {id: supplier.supplier_id}) }}" onsubmit="return confirm('Удалить поставщика?')">
                  <button class="btn danger" type="submit">Удалить</button>
                </form>
              </div>
            </td>
          </tr>
          <dialog id="edit-supplier-{{ supplier.supplier_id }}">
            <form method="post" action="{{ path('references_suppliers_edit', {id: supplier.supplier_id}) }}">
              <div class="modal-head"><h2>Поставщик</h2><button class="btn secondary" type="button" onclick="closeModal('edit-supplier-{{ supplier.supplier_id }}')">Закрыть</button></div>
              <div class="modal-body"><label>Название <input name="supplier_name" value="{{ supplier.supplier_name }}" maxlength="100" required></label></div>
              <div class="modal-foot"><button class="btn secondary" type="button" onclick="closeModal('edit-supplier-{{ supplier.supplier_id }}')">Отмена</button><button class="btn" type="submit">Сохранить</button></div>
            </form>
          </dialog>
        {% else %}
          <tr><td colspan="2" class="muted">Поставщики не добавлены</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="card" style="margin-top:16px">
    <div class="table-actions" style="justify-content:space-between;margin-bottom:12px">
      <h2>Продукты</h2>
      <button class="btn" type="button" onclick="openModal('create-product')">Добавить продукт</button>
    </div>
    <table>
      <thead><tr><th>Название</th><th>Остаток при создании</th><th>Минимум</th><th>Действия</th></tr></thead>
      <tbody>
      {% for product in products %}
        <tr>
          <td>{{ product.product_name }}</td>
          <td>{{ product.quantity is not null ? product.quantity|number_format(2, ',', ' ') : 'Нет строки склада' }}</td>
          <td>{{ product.min_quantity is not null ? product.min_quantity|number_format(2, ',', ' ') : 'Нет строки склада' }}</td>
          <td>
            <div class="table-actions">
              <button class="btn secondary" type="button" onclick="openModal('edit-product-{{ product.product_id }}')">Изменить</button>
              <form method="post" action="{{ path('references_products_delete', {id: product.product_id}) }}" onsubmit="return confirm('Удалить продукт? Если он используется в рецептах или заявках, удаление будет запрещено.')">
                <button class="btn danger" type="submit">Удалить</button>
              </form>
            </div>
          </td>
        </tr>
        <dialog id="edit-product-{{ product.product_id }}">
          <form method="post" action="{{ path('references_products_edit', {id: product.product_id}) }}">
            <div class="modal-head"><h2>Продукт</h2><button class="btn secondary" type="button" onclick="closeModal('edit-product-{{ product.product_id }}')">Закрыть</button></div>
            <div class="modal-body"><label>Название <input name="product_name" value="{{ product.product_name }}" maxlength="100" required></label></div>
            <div class="modal-foot"><button class="btn secondary" type="button" onclick="closeModal('edit-product-{{ product.product_id }}')">Отмена</button><button class="btn" type="submit">Сохранить</button></div>
          </form>
        </dialog>
      {% else %}
        <tr><td colspan="4" class="muted">Продукты не добавлены</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <dialog id="create-manager">
    <form method="post" action="{{ path('references_managers_create') }}">
      <div class="modal-head"><h2>Новый менеджер</h2><button class="btn secondary" type="button" onclick="closeModal('create-manager')">Закрыть</button></div>
      <div class="modal-body"><label>ФИО <input name="manager_full_name" maxlength="100" required></label></div>
      <div class="modal-foot"><button class="btn secondary" type="button" onclick="closeModal('create-manager')">Отмена</button><button class="btn" type="submit">Создать</button></div>
    </form>
  </dialog>

  <dialog id="create-supplier">
    <form method="post" action="{{ path('references_suppliers_create') }}">
      <div class="modal-head"><h2>Новый поставщик</h2><button class="btn secondary" type="button" onclick="closeModal('create-supplier')">Закрыть</button></div>
      <div class="modal-body"><label>Название <input name="supplier_name" maxlength="100" required></label></div>
      <div class="modal-foot"><button class="btn secondary" type="button" onclick="closeModal('create-supplier')">Отмена</button><button class="btn" type="submit">Создать</button></div>
    </form>
  </dialog>

  <dialog id="create-product">
    <form method="post" action="{{ path('references_products_create') }}">
      <div class="modal-head"><h2>Новый продукт</h2><button class="btn secondary" type="button" onclick="closeModal('create-product')">Закрыть</button></div>
      <div class="modal-body form-grid">
        <label>Название <input name="product_name" maxlength="100" required></label>
        <label>Остаток <input name="quantity" type="number" min="0" step="0.01" value="0" required></label>
        <label>Минимальный остаток <input name="min_quantity" type="number" min="0" step="0.01" value="10" required></label>
      </div>
      <div class="modal-foot"><button class="btn secondary" type="button" onclick="closeModal('create-product')">Отмена</button><button class="btn" type="submit">Создать</button></div>
    </form>
  </dialog>
{% endblock %}
